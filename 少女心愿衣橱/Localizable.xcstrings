    "展示您的衣橱统计与近期动态": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Statistiken und Neuigkeiten aus deinem Kleiderschrank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your closet stats and recent activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las estadísticas y la actividad reciente de tu armario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les statistiques et l’activité récente de votre dressing."
