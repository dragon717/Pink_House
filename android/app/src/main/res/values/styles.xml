<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PinkHouse.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8E2E7</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/pink_house_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">#FFF7F9</item>
        <item name="postSplashScreenTheme">@style/Theme.PinkHouse</item>
        <item name="android:windowBackground">@drawable/pink_splash_window</item>
    </style>

    <style name="Theme.PinkHouse" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/pink_house_seed</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFF7F9</item>
    </style>
</resources>
