    "· 更多会员权益正在路上" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· Weitere Vorteile sind unterwegs"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· More member benefits are on the way"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· Vienen mas beneficios"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· D'autres avantages arrivent"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· さらに多くの会員特典を準備中"
