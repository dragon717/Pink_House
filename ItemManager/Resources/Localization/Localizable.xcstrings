    "由于虚拟商品的特殊性，购买成功后不支持退款" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because these are virtual goods, refunds are not supported after a successful purchase."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于虚拟商品的特殊性，购买成功后不支持退款"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於虛擬商品的特殊性，購買成功後不支援退款"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想商品の性質上、購入完了後の返金には対応していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가상 상품의 특성상 구매가 완료된 후에는 환불이 지원되지 않습니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme il s'agit de biens virtuels, les remboursements ne sont pas pris en charge apres un achat reussi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da es sich um virtuelle Waren handelt, werden nach erfolgreichem Kauf keine Rueckerstattungen unterstuetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como son bienes virtuales, no se admiten reembolsos despues de una compra correcta."
          }
