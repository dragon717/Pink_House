      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich finde diesen Gegenstand gerade nicht. Schau später noch einmal für mich nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I cannot find that item right now. Please check again for me later."
