    "带我去商店补一点猫粮、罐头或者玩具吧。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring mich in den Laden, um etwas Futter, Dosen oder Spielzeug aufzufüllen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take me to the shop to restock some kibble, cans, or toys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llévame a la tienda para reponer comida, latas o juguetes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emmène-moi à la boutique refaire le plein de croquettes, de boîtes ou de jouets."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショップでフードや缶詰、おもちゃを少し補充しよう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상점에 데려가서 사료, 캔, 장난감을 조금 채워 줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me leve à loja para repor ração, latinhas ou brinquedos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带我去商店补一点猫粮、罐头或者玩具吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帶我去商店補一點貓糧、罐頭或者玩具吧。"
          }
        }
      }
    },
