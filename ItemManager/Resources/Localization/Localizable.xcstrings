        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주인님, 펫 상점에 보급하러 가요! %@ 먹고 싶어요. 조금 사 주면 안 될까요, 멍!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
