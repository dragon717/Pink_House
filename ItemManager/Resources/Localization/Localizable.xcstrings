    "奶茶优先赚鱼币，毛毛优先赚骨头币。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milk Tea prioritizes Fish Coins, while Mao Mao prioritizes Bone Coins."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "奶茶优先赚鱼币，毛毛优先赚骨头币。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "奶茶優先賺魚幣，毛毛優先賺骨頭幣。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミルクティーはさかなコイン、マオマオはほねコインを優先して稼ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밀크티는 물고기 코인, 마오마오는 뼈다귀 코인을 우선으로 벌어요."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milk Tea privilégie les pièces Poisson, tandis que Mao Mao privilégie les pièces Os."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milk Tea verdient bevorzugt Fischmünzen, Mao Mao bevorzugt Knochenmünzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milk Tea prioriza monedas Pez y Mao Mao prioriza monedas Hueso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milk Tea prioriza Moedas Peixe, enquanto Mao Mao prioriza Moedas Osso."
          }
        }
      }
    },
