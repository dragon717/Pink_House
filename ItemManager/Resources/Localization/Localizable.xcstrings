        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encuentro ese objeto por ahora. Vuelve a revisarlo por mí más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne trouve pas cet objet pour l’instant. Regarde encore pour moi plus tard."
