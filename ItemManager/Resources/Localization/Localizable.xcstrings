    "我有一点点饿，点下面按钮就能马上喂我。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe ein kleines bisschen Hunger. Tippe unten, um mich gleich zu füttern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am a little hungry. Tap below to feed me right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tengo un poquito de hambre. Toca abajo para darme de comer enseguida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai un peu faim. Appuie ci-dessous pour me nourrir tout de suite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少しだけお腹が空いています。下のボタンですぐ食べさせてね。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조금 배고파요. 아래 버튼을 누르면 바로 먹일 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estou com um pouquinho de fome. Toque abaixo para me alimentar agora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我有一点点饿，点下面按钮就能马上喂我。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我有一點點餓，點下面按鈕就能馬上餵我。"
          }
        }
      }
    },
    "我真的有点饿啦，最好先让我吃一口" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ich bin wirklich etwas hungrig und sollte zuerst etwas essen"
          }
