    "今天偏凉，薄外套或开衫会更舒服%@。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist es kühl; eine leichte Jacke oder Strickjacke ist angenehmer%@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It’s cool today; a light jacket or cardigan will feel better%@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy está fresco; una chaqueta ligera o cárdigan será más cómodo%@."
