    "我整体心情还算稳定，陪我聊两句会更开心。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Stimmung ist insgesamt stabil. Wenn du kurz mit mir plauderst, werde ich noch fröhlicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My mood is mostly steady. Chat with me a little and I will feel even happier."
          }
