    "我的%@不够啦，先帮我攒一点再来买%@吧。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe nicht genug %@. Sammle erst ein bisschen, dann kaufen wir %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I do not have enough %@. Help me save a little more before buying %@."
