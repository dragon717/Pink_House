          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在猫咖被rua，赚取少量鱼币，稍微有点累。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在貓咖被 rua，賺取少量魚幣，稍微有點累。"
          }
        }
      }
    },
