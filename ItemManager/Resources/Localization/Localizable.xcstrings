            "value" : "ahora mismo me siento bastante lleno"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "je me sens encore bien rassasié"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今はけっこうお腹いっぱいです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 꽤 배가 불러요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ainda estou bem satisfeito"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我现在还挺有饱腹感的"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我現在還挺有飽腹感的"
          }
        }
      }
    },
    "我现在不太饿，想让我继续稳稳的，可以先帮我备点吃的。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe gerade kaum Hunger. Wenn du mich stabil halten möchtest, kannst du schon etwas Futter vorbereiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am not very hungry right now. If you want to keep me steady, you can prepare a little food for me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no tengo mucha hambre. Si quieres mantenerme estable, puedes preparar algo de comida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n’ai pas très faim pour l’instant. Tu peux préparer un peu à manger pour me garder bien stable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今はあまりお腹が空いていません。安定させたいなら、少し食べ物を用意しておいてね。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 별로 배고프지 않아요. 계속 안정적으로 지내게 하려면 먹을 걸 조금 준비해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não estou com muita fome agora. Para me manter bem, você pode preparar um pouco de comida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我现在不太饿，想让我继续稳稳的，可以先帮我备点吃的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我現在不太餓，想讓我繼續穩穩的，可以先幫我備點吃的。"
          }
        }
      }
    },
    "我有点想加餐啦" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ich hätte langsam Lust auf einen Snack"
