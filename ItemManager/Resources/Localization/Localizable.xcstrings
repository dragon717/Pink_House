    },
    "• 保持热爱，奔赴山海。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Bewahre deine Liebe und lauf den Bergen und Meeren entgegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Keep your passion and run toward mountains and seas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Conserva lo que amas y corre hacia montañas y mares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Garde ta passion et pars vers les montagnes et les mers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 好きを抱いたまま、山と海へ向かおう。"
          }
        },
        "ko" : {
