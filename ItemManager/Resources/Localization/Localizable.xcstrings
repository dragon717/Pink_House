    "我先帮你把宠物商店打开啦，等店里补货了我们再来挑。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe den Haustierladen schon geöffnet. Wenn Nachschub da ist, suchen wir wieder aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I opened the pet shop for you. We can choose again once it restocks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrí la tienda de mascotas por ti. Cuando repongan stock, volveremos a elegir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai ouvert la boutique de pets pour toi. Quand le stock sera revenu, nous choisirons ensemble."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先にペットショップを開いておくね。お店に在庫が入ったらまた選びに来よう。"
          }
