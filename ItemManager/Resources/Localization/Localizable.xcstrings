    "今天偏暖，通常不用特地带外套。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist es eher warm; normalerweise brauchst du keine extra Jacke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It’s warm today; you usually don’t need to bring outerwear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy está más bien cálido; normalmente no hace falta llevar abrigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fait plutôt chaud aujourd’hui; pas besoin de prendre une veste en général."
          }
