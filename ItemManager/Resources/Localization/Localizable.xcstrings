    "包含 %d 件库存，单套价值 ¥%@；邮费不随库存倍增" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes %d in stock. Each set is worth ¥%@; shipping is not multiplied by stock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含 %d 件库存，单套价值 ¥%@；邮费不随库存倍增"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含 %d 件庫存，單套價值 ¥%@；郵費不隨庫存倍增"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在庫%d点を含み、1セットの価値は¥%@です。送料は在庫数で倍増しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재고 %d개 포함, 세트당 가치 ¥%@. 배송비는 재고 수만큼 늘어나지 않습니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclut %d en stock. Chaque ensemble vaut ¥%@ ; les frais d’envoi ne sont pas multipliés par le stock."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält %d auf Lager. Ein Set ist ¥%@ wert; Versand wird nicht mit dem Bestand multipliziert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye %d en inventario. Cada conjunto vale ¥%@; el envío no se multiplica por el inventario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui %d em estoque. Cada conjunto vale ¥%@; o frete não é multiplicado pelo estoque."
          }
        }
      }
    },
