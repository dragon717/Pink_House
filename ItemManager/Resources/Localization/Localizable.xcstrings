          }
        }
      }
    },
    "将把当前数据打包成本地备份文件，过程可能需要一点时间。确定继续吗？" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will package your current data into a local backup file. It may take a moment. Continue?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将把当前数据打包成本地备份文件，过程可能需要一点时间。确定继续吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會將目前資料打包成本機備份檔案，過程可能需要一點時間。確定要繼續嗎？"
          }
        }
      }
    },
    "将把当前本地数据上传为一份云端备份。若云端已有旧备份，会以最新上传内容为准。确定继续吗？" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will upload your current local data as a cloud backup. If an older backup already exists in the cloud, the latest upload will be used. Continue?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将把当前本地数据上传为一份云端备份。若云端已有旧备份，会以最新上传内容为准。确定继续吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會將目前本機資料上傳為一份雲端備份。若雲端已有舊備份，將以最新上傳內容為準。確定要繼續嗎？"
          }
        }
      }
    },
    "将把选中的 %lld 个抠图设置为对应裙装的第一张图片（主图）。原图将后移。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the selected %lld cutouts as the first image (main image) for their dress items. Existing images will move back."
