    "下午的时光，适合发呆，适合想你" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Nachmittag passt zum Träumen und zum Denken an dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afternoon is made for drifting thoughts and thinking of you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarde es para dejar la mente volar y pensar en ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'après-midi est fait pour rêver et penser à toi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "午後の時間は、ぼんやりするのにも、あなたを想うのにも似合う。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오후의 시간은 멍하니 있기에도, 너를 생각하기에도 좋아."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tarde combina com devaneios e com pensar em você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下午的时光，适合发呆，适合想你"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下午的時光，適合發呆，適合想你"
          }
        }
      }
    },
    "下次启动应用时将重新显示新手引导。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The onboarding guide will be shown again the next time the app starts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
