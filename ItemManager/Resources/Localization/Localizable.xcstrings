        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "j’ai vraiment un peu faim, mieux vaut me laisser manger d’abord"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当に少しお腹が空いてきたので、まず食べさせてほしいです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
