    "星光还在值班，月亮说该你接班了" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Sternenlicht ist noch im Dienst; der Mond sagt, jetzt bist du dran."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starlight is still on duty; the moon says it is your turn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luz de las estrellas sigue de guardia; la luna dice que es tu turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lumière des étoiles est encore de garde; la lune dit que c'est ton tour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星明かりはまだ当番中、月があなたの番だと言っている。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "별빛은 아직 근무 중이고, 달은 이제 네 차례래."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A luz das estrelas ainda está de plantão; a lua diz que é sua vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星光还在值班，月亮说该你接班了"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星光還在值班，月亮說該你接班了"
          }
        }
      }
    },
