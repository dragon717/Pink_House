        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は暖かめなので、基本的にアウターはなくても大丈夫。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 따뜻한 편이라 보통은 겉옷을 따로 챙기지 않아도 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje está mais quente; geralmente não precisa levar casaco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
