        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今ちょっと気持ちが複雑です。先に少し話を聞いてから、やさしいコーデ提案をください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 마음이 좀 복잡해요. 먼저 이야기해주고, 그다음 부드러운 코디 조언을 해줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meu humor está meio confuso agora. Converse comigo primeiro e depois me dê uma sugestão de look bem gentil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我现在心情有点复杂，先陪我聊聊，再给我温柔一点的穿搭建议。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我現在心情有點複雜，先陪我聊聊，再給我溫柔一點的穿搭建議。"
          }
        }
      }
