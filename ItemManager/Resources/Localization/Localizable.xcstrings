    "给%@洗香香要花%d%@，我现在%@还不够，先带你去充值。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zu waschen kostet %d %@. Ich habe gerade nicht genug %@, also bringe ich dich erst zum Aufladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Washing %@ costs %d %@. I do not have enough %@ right now, so I will take you to top up first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bañar a %@ cuesta %d %@. Ahora no tengo suficientes %@, así que te llevaré a recargar primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
