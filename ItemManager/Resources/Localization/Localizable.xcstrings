            "state" : "translated",
            "value" : "%@ n’est pas dans le sac pour l’instant, alors j’ouvre la boutique pour refaire le stock."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は今バッグにありません。補充できるようにお店を開くね。"
