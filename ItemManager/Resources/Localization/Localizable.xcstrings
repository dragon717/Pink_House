    "今天偏冷，最好带外套%@。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist es kalt; eine Jacke ist am besten%@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It’s cold today; bringing outerwear is best%@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy hace frío; lo mejor es llevar abrigo%@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fait froid aujourd’hui; mieux vaut prendre une veste%@."
