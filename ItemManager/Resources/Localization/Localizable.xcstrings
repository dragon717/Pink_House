    "在猫咖被rua，赚取少量鱼币，稍微有点累。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gets cuddled at the cat cafe, earns a few Fish Coins, and gets a little tired."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在猫咖被rua，赚取少量鱼币，稍微有点累。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在貓咖被 rua，賺取少量魚幣，稍微有點累。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "猫カフェでなでられて、少しのさかなコインを稼ぎ、少し疲れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고양이 카페에서 쓰다듬받고 물고기 코인을 조금 벌지만 살짝 피곤해져요."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se fait câliner au café-chat, gagne quelques pièces Poisson et fatigue un peu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird im Katzencafé gekuschelt, verdient ein paar Fischmünzen und wird etwas müde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe mimos en el café gatuno, gana algunas monedas Pez y se cansa un poco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recebe carinho no café de gatos, ganha algumas Moedas Peixe e fica um pouco cansado."
          }
        }
      }
    },
    "在线卖萌直播，赚取巨量鱼币，非常累！" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
