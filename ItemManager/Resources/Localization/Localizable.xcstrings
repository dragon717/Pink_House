          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は少し涼しいので、薄手のアウターやカーディガンが快適%@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 선선해서 얇은 겉옷이나 카디건이 더 편해요%@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje está fresco; uma jaqueta leve ou cardigan fica mais confortável%@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天偏凉，薄外套或开衫会更舒服%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天偏涼，薄外套或開衫會更舒服%@。"
          }
        }
      }
    },
    "风有点明显，带件薄外套会更安心%@。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wind ist spürbar; mit einer leichten Jacke bist du sicherer%@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wind is noticeable; a light jacket will feel safer%@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El viento se nota; una chaqueta ligera dará más tranquilidad%@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
