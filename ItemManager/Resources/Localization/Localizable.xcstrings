    "iCloud 同步可以将您的数据自动备份到云端，并在您的所有设备之间同步。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Sync automatically backs up your data to the cloud and keeps it in sync across your devices."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步可以将您的数据自动备份到云端，并在您的所有设备之间同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步可以將您的數據自動備份到雲端，並在您的所有設備之間同步。"
          }
        }
      }
    },
    "iCloud 同步管理" : {
      "localizations" : {
        "en" : {
