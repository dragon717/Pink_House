    "晨光为你铺好了路，今天也要闪闪发光" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Morgenlicht hat dir den Weg bereitet; strahle auch heute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morning light has paved the way for you; shine today too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luz de la mañana te preparó el camino; brilla también hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lumière du matin a préparé ton chemin; brille encore aujourd'hui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝の光が道を敷いてくれた、今日もきらきら輝こう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아침빛이 네 길을 깔아 두었어, 오늘도 반짝여 줘."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A luz da manhã preparou o caminho; brilhe também hoje."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晨光为你铺好了路，今天也要闪闪发光"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晨光為你鋪好了路，今天也要閃閃發光"
          }
        }
      }
    },
