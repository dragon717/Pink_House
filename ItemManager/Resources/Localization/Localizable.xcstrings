    "现在空闲。可以点按钮让%@去打工，或开启闲时自动打工。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade frei. Du kannst %@ per Schaltfläche zur Arbeit schicken oder Auto-Arbeit für freie Zeiten aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Currently idle. Tap a button to send %@ to work, or enable auto work while idle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora está libre. Puedes tocar un botón para enviar a %@ a trabajar, o activar trabajo automático cuando esté libre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libre pour le moment. Tu peux appuyer sur un bouton pour envoyer %@ travailler, ou activer le travail auto pendant les temps libres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今は空いています。ボタンで%@を仕事に行かせるか、暇なときの自動仕事をオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 한가해요. 버튼을 눌러 %@를 일하러 보내거나, 한가할 때 자동 일하기를 켤 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está livre agora. Você pode tocar em um botão para mandar %@ trabalhar ou ativar trabalho automático quando estiver livre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在空闲。可以点按钮让%@去打工，或开启闲时自动打工。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在空閒。可以點按按鈕讓%@去打工，或開啟閒時自動打工。"
          }
        }
      }
