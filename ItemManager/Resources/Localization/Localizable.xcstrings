        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "猫カフェでなでられて、少しのさかなコインを稼ぎ、少し疲れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고양이 카페에서 쓰다듬받고 물고기 코인을 조금 벌지만 살짝 피곤해져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
