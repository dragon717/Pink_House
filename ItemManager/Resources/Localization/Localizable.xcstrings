    "保存时会自动写入为「全款预约」，不再显示定金、尾款或尾款日期。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When saved, this will be recorded as “full reservation”; deposit, balance, and balance due date will no longer be shown."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存时会自动写入为「全款预约」，不再显示定金、尾款或尾款日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存時會自動寫入為「全款預約」，不再顯示訂金、尾款或尾款日期。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存時に「全額予約」として記録され、内金・残金・残金予定日は表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하면 “전액 예약”으로 기록되며, 계약금과 잔금 및 잔금 날짜는 더 이상 표시되지 않습니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À l’enregistrement, ce sera noté comme « réservation complète » ; l’acompte, le solde et la date du solde ne seront plus affichés."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Speichern wird dies als „Vollreservierung“ erfasst; Anzahlung, Restbetrag und Fälligkeitsdatum werden nicht mehr angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al guardar, se registrará como “reserva completa”; ya no se mostrarán el depósito, el saldo ni la fecha de saldo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao salvar, será registrado como “reserva integral”; sinal, saldo e data do saldo não serão mais exibidos."
          }
        }
      }
    },
