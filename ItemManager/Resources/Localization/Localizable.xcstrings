        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe gerade ins Regal geschaut. Im Laden gibt es jetzt %@. Antippen legt es zuerst in den Rucksack; zieh es dann in den Fütterbereich, damit ich sofort essen oder trinken kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I just checked the shelves. The shop has %@ right now. Tap to put it in the inventory, then drag it to the feeding area so I can enjoy it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acabo de revisar el estante. Ahora la tienda tiene %@. Toca para guardarlo primero en la mochila y arrástralo a la zona de comida para dármelo enseguida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je viens de surveiller les rayons : il y a %@ en boutique. Touche pour mettre dans le sac, puis fais glisser vers la zone de repas pour me le donner tout de suite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さっき棚を確認したよ。今お店には%@がある。タップで先にバッグへ入れて、餌やりエリアへドラッグするとすぐ食べたり飲んだりできるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방금 진열대를 살펴봤어요. 지금 가게에는 %@가 있어요. 한 번 탭해서 먼저 가방에 넣고, 먹이 주기 구역으로 끌면 바로 먹고 마실 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acabei de olhar a prateleira. Agora a loja tem %@. Toque para colocar primeiro na mochila e arraste para a área de alimentação para eu comer ou beber na hora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我刚刚盯过货架啦，现在店里有%@。点一下先放进背包，拖到投喂区就能马上给我吃喝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我剛剛盯過貨架啦，現在店裡有%@。點一下先放進背包，拖到投餵區就能馬上給我吃喝。"
          }
        }
      }
    },
