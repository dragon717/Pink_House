    "我现在还挺有饱腹感的" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ich bin gerade ziemlich satt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I still feel pretty full"
          }
        },
        "es" : {
          "stringUnit" : {
