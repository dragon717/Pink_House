        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我真的有點餓啦，最好先讓我吃一口"
          }
        }
      }
    },
    "我现在饱食偏低，先打开背包喂我，或者带我去商店补货都可以。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Sättigung ist gerade niedrig. Öffne zuerst den Rucksack zum Füttern oder nimm mich mit zum Shop zum Nachfüllen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My fullness is running low. Open the bag to feed me first, or take me to the shop to restock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi saciedad está baja. Abre la mochila para alimentarme o llévame a la tienda para reponer."
          }
        },
        "fr" : {
