        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온라인에서 귀여움을 방송해 물고기 코인을 많이 벌지만 아주 피곤해져요!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait un live tout mignon, gagne beaucoup de pièces Poisson et se fatigue énormément !"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamt niedliche Momente online, verdient viele Fischmünzen und wird sehr müde!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace directos adorables, gana muchas monedas Pez y se cansa muchísimo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz lives fofas, ganha muitas Moedas Peixe e fica muito cansado!"
          }
        }
      }
