        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi ánimo está bastante estable. Si charlas un poco conmigo, estaré más feliz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
