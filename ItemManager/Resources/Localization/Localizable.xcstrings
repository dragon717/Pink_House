          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次啓動應用時將重新顯示新手引導。"
          }
        }
      }
    },
    "下滑收起，点「显示」临时展开，回到顶部恢复。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach unten wischen zum Einklappen. Tippe auf \"Anzeigen\", um vorübergehend zu öffnen. Oben wird es wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe down to collapse. Tap \"Show\" to expand temporarily. Returning to top restores it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia abajo para contraer. Toca \"Mostrar\" para abrir temporalmente. Al volver arriba se restaura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers le bas pour réduire. Touchez \"Afficher\" pour ouvrir temporairement. Le retour en haut rétablit l’affichage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下にスワイプで折りたたみ。「表示」で一時的に展開し、上部へ戻ると復元します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래로 밀면 접히고, \"표시\"를 누르면 임시로 펼쳐져요. 맨 위로 돌아가면 복원됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para baixo para recolher. Toque em \"Mostrar\" para abrir temporariamente. Ao voltar ao topo, restaura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下滑收起，点「显示」临时展开，回到顶部恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下滑收起，點「顯示」可暫時展開，回到頂部後恢復。"
          }
        }
      }
    },
    "下滑收起，点显示临时展开，回到顶部恢复" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach unten wischen zum Einklappen. Auf Anzeigen tippen, um vorübergehend zu öffnen. Oben wird es wiederhergestellt."
