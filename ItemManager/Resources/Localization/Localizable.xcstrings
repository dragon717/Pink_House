    "负责巡逻抓老鼠，赚取大等鱼币，比较累。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patrols and catches mice, earns a decent amount of Fish Coins, and gets fairly tired."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负责巡逻抓老鼠，赚取大等鱼币，比较累。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
