          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天偏暖，通常不用特地帶外套。"
          }
        }
      }
    },
    "虽然温度高一点，但带件轻薄外搭会更灵活%@。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch wenn es etwas wärmer ist, macht eine leichte Außenschicht dich flexibler%@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even though it’s warmer, a light outer layer will keep the outfit more flexible%@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque la temperatura sea más alta, una capa ligera te dará más flexibilidad%@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même s’il fait un peu plus chaud, une couche légère rendra la tenue plus flexible%@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少し暖かくても、軽い羽織りがあると調整しやすい%@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기온이 조금 높아도 가벼운 겉옷이 있으면 더 유연하게 입을 수 있어요%@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo com a temperatura um pouco mais alta, uma camada leve deixa o look mais flexível%@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
