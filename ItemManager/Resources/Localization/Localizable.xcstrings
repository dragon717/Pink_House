        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 펫 상점을 열어 둘게요. 가게에 물건이 들어오면 다시 고르러 와요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abri a loja de pets para você. Quando o estoque voltar, escolhemos de novo."
