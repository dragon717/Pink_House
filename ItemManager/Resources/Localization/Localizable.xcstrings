        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 추운 편이라 겉옷을 챙기는 게 좋아요%@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
