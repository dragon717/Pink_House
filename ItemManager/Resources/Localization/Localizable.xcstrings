      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin kurz hängengeblieben. Wechsel zu einem stabileren Netzwerk, dann versuchen wir es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I got a little stuck. Try a steadier network and we can try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me quedé un poco atascado. Prueba una red más estable y lo intentamos otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'ai un peu bloqué. Essaie avec un réseau plus stable et on réessaie."
