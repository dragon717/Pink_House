    "状态很好时才上强度，收益更高也更累。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitet nur härter, wenn die Werte sehr gut sind. Mehr Einnahmen, aber anstrengender."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only works harder when stats are great. Higher earnings, but more tiring."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo trabaja más duro cuando el estado es excelente. Más ganancias, pero más cansancio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaille plus fort seulement quand tout va très bien. Gains plus élevés, mais plus de fatigue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状態がとても良い時だけ頑張ります。収益は高いけれど疲れやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태가 아주 좋을 때만 강도를 올려요. 수익은 높지만 더 피곤해져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só pega pesado quando o status está ótimo. Mais ganhos, mas cansa mais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状态很好时才上强度，收益更高也更累。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "狀態很好時才上強度，收益更高也更累。"
          }
        }
      }
    },
