        }
      }
    },
    "全款预约需要先填写裙装总价、小物或邮费" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For full-payment reservations, enter a dress total, accessories, or shipping fee first."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全款预约需要先填写裙装总价、小物或邮费"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全款預約需要先填寫裙裝總價、小物或郵費"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全額予約には、先にドレス合計・小物・送料のいずれかを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전액 예약은 먼저 드레스 총액, 소품 또는 배송비를 입력해야 합니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une réservation payée en totalité, renseignez d’abord le total de la robe, les accessoires ou les frais de port."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib für Vollzahlungsreservierungen zuerst Kleidgesamtbetrag, Accessoires oder Versandkosten ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reservas de pago completo, introduce primero el total del vestido, accesorios o envío."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reservas com pagamento integral, informe primeiro o total do vestido, acessórios ou frete."
          }
        }
      }
    },
    "定金尾款需要先填写尾款金额；从已拥有切换时可先填写裙装总价，我会自动转为待付尾款" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deposit and balance plans need a balance amount first; when switching from Owned, you can enter the dress total and I will convert it to a pending balance automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定金尾款需要先填写尾款金额；从已拥有切换时可先填写裙装总价，我会自动转为待付尾款"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定金尾款需要先填寫尾款金額；從已擁有切換時可先填寫裙裝總價，我會自動轉為待付尾款"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内金・残金プランには先に残金額が必要です。所有済みから切り替える場合はドレス合計を入力すれば、自動で残金待ちに変換します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예약금/잔금 플랜은 먼저 잔금 금액이 필요합니다. 보유 중에서 전환할 때는 드레스 총액을 입력하면 자동으로 잔금 대기로 전환합니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans avec acompte et solde nécessitent d’abord un montant de solde ; lors du passage depuis Possédée, saisissez le total de la robe et je le convertirai automatiquement en solde à payer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahlungs- und Restbetragspläne benötigen zuerst einen Restbetrag; beim Wechsel aus Im Besitz kannst du den Kleidgesamtbetrag eingeben, ich wandle ihn automatisch in einen offenen Restbetrag um."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los planes de depósito y saldo necesitan primero un importe de saldo; al cambiar desde En propiedad, puedes introducir el total del vestido y lo convertiré automáticamente en saldo pendiente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planos de entrada e saldo precisam primeiro de um valor de saldo; ao mudar de Já possui, informe o total do vestido e eu converterei automaticamente para saldo pendente."
          }
        }
      }
    },
