    "%@这套先这样，要不要继续微调？" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für %@ passt dieses Outfit erstmal. Weiter feinabstimmen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For %@, this outfit can start here. Want to keep fine-tuning?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para %@, este look puede quedar así por ahora. ¿Quieres seguir ajustándolo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour %@, cette tenue peut déjà fonctionner. Tu veux continuer à l’ajuster ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@なら、このコーデでまずよさそう。もう少し調整する？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 이 코디로 먼저 가 볼까요? 더 다듬어 볼래요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para %@, este look já funciona por enquanto. Quer continuar ajustando?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@这套先这样，要不要继续微调？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@這套先這樣，要不要繼續微調？"
          }
        }
      }
    },
    "这套先给你摆在上面啦，要不要继续微调？" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe dieses Outfit oben für dich platziert. Weiter feinabstimmen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I placed this outfit above for you. Want to keep fine-tuning?"
          }
        },
        "es" : {
