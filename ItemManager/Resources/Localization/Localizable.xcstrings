    "保存后会把这条裙装从「已拥有」切换为「%@」，并将裙装状态改为「%@」。%@" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Speichern wechselt dieses Kleid von „Im Besitz“ zu „%@“, und der Zustand wird zu „%@“ geändert. %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After saving, this dress will switch from “Owned” to “%@”, and its condition will change to “%@”. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de guardar, este vestido cambiará de “En propiedad” a “%@”, y su estado pasará a “%@”. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l’enregistrement, cette robe passera de « Possédée » à « %@ », et son état deviendra « %@ ». %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存後、このドレスは「所有済み」から「%@」に切り替わり、状態は「%@」になります。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장 후 이 드레스는 “보유 중”에서 “%@”로 전환되고 상태가 “%@”로 변경됩니다.%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após salvar, este vestido mudará de “Já possui” para “%@”, e a condição mudará para “%@”. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存后会把这条裙装从「已拥有」切换为「%@」，并将裙装状态改为「%@」。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存後會把這條裙裝從「已擁有」切換為「%@」，並將裙裝狀態改為「%@」。%@"
          }
        }
      }
    },
