    "，雨天鞋子和伞也尽量选稳一点" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", und bei Regen sollten Schuhe und Schirm möglichst zuverlässig sein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", and for rain, choose steadier shoes and an umbrella"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", y si llueve, elige zapatos y paraguas más seguros"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", et par temps de pluie, choisis des chaussures et un parapluie plus sûrs"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "。雨の日は靴と傘も安定感のあるものを選んでね"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", 비 오는 날에는 신발과 우산도 안정적인 걸로 골라요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", e em dias de chuva escolha sapatos e guarda-chuva mais seguros"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "，雨天鞋子和伞也尽量选稳一点"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "，雨天鞋子和傘也盡量選穩一點"
          }
        }
      }
    },
