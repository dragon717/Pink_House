    "全款预约：进入预约列表，只显示全款预约日期和全款金额。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full reservation: added to the reservation list and shows only the full reservation date and amount."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全款预约：进入预约列表，只显示全款预约日期和全款金额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全款預約：進入預約列表，只顯示全款預約日期和全款金額。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全額予約：予約リストに入り、全額予約日と金額のみ表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전액 예약: 예약 목록에 들어가며 전액 예약 날짜와 금액만 표시됩니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réservation complète : ajoutée à la liste des réservations, avec seulement la date et le montant complet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollreservierung: Wird zur Reservierungsliste hinzugefügt und zeigt nur Datum und Betrag der Vollreservierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserva completa: entra en la lista de reservas y solo muestra fecha e importe completos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserva integral: entra na lista de reservas e mostra apenas a data e o valor integral."
          }
        }
      }
    },
    "全款预约会复用现有预约数据结构：保存时自动将全款金额写入定金字段，尾款为 0。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full reservation reuses the existing reservation structure: when saved, the full amount is written to the deposit field and the balance is 0."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全款预约会复用现有预约数据结构：保存时自动将全款金额写入定金字段，尾款为 0。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全款預約會復用現有預約資料結構：儲存時自動將全款金額寫入訂金欄位，尾款為 0。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全額予約は既存の予約データ構造を利用します。保存時に全額を内金欄へ書き込み、残金は0になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전액 예약은 기존 예약 데이터 구조를 재사용합니다. 저장 시 전액이 계약금 필드에 기록되고 잔금은 0이 됩니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réservation complète réutilise la structure existante : à l’enregistrement, le montant complet est écrit dans l’acompte et le solde vaut 0."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vollreservierung nutzt die bestehende Reservierungsstruktur: Beim Speichern wird der volle Betrag in die Anzahlung geschrieben, der Restbetrag ist 0."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reserva completa reutiliza la estructura existente: al guardar, el importe completo se escribe en depósito y el saldo queda en 0."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reserva integral reutiliza a estrutura existente: ao salvar, o valor integral vai para o campo de sinal e o saldo fica 0."
          }
        }
      }
    },
