    "达到开始线才会自动出门，跌到停工线会自动下班。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-Arbeit startet erst ab dem Startwert und stoppt beim Stoppwert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto work starts only after reaching the start line, and stops when it drops to the stop line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo automático empieza al alcanzar el umbral de inicio y se detiene al caer al umbral de parada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail auto démarre seulement au seuil de départ et s'arrête au seuil d'arrêt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始ラインに達すると自動で出勤し、停止ラインまで下がると自動で帰ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작선에 도달해야 자동으로 나가고, 중지선까지 떨어지면 자동으로 퇴근해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trabalho automático começa ao atingir a linha de início e para ao cair até a linha de parada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "达到开始线才会自动出门，跌到停工线会自动下班。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "達到開始線才會自動出門，跌到停工線會自動下班。"
          }
        }
      }
    },
