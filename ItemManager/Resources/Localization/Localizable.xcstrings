        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fait frais aujourd’hui; une veste légère ou un cardigan sera plus confortable%@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は少し涼しいので、薄手のアウターやカーディガンが快適%@。"
