    "帮我看下天气，并结合衣橱推荐外套、裙子、鞋子和伞。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau dir bitte das Wetter an und empfiehl mir aus meiner Garderobe Jacke, Kleid, Schuhe und Schirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the weather and recommend outerwear, a dress, shoes, and an umbrella from my wardrobe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el clima y recomiéndame abrigo, vestido, zapatos y paraguas desde mi armario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde la météo et recommande une veste, une robe, des chaussures et un parapluie depuis ma garde-robe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天気を見て、衣装棚からアウター、ワンピ、靴、傘をおすすめしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날씨를 보고 옷장에서 겉옷, 원피스, 신발, 우산을 추천해줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja o clima e recomende casaco, vestido, sapatos e guarda-chuva do meu guarda-roupa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帮我看下天气，并结合衣橱推荐外套、裙子、鞋子和伞。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幫我看下天氣，並結合衣櫥推薦外套、裙子、鞋子和傘。"
          }
        }
      }
    },
